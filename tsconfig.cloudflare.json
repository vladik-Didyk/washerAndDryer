{
  "extends": "./tsconfig.json",
  "include": [".react-router/types/**/*", "src/**/*", "workers/**/*", "worker-configuration.d.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [".", "./.react-router/types"],
    "paths": { "~/*": ["./src/*"] },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
