# Copy to .dev.vars for local development (pnpm dev / pnpm preview / wrangler dev).
# .dev.vars is gitignored. In production set these with `wrangler secret put NAME`
# (or as plain variables in the Cloudflare dashboard for the non-secret ones).

# Secrets

SESSION_SECRET=

# Optional settings ("1" turns a switch on)
# FORMS_DRY_RUN=1          # log form emails instead of sending them
# PREVIEW_DRAFTS=1         # show draft pages (guides, /privacy/, /terms/) with a Draft ribbon
# STRIPE_PORTAL_URL=       # https://billing.stripe.com/p/login/... ; enables /account/
# CF_ANALYTICS_TOKEN=      # Cloudflare Web Analytics token; adds the beacon
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
