// Cloudflare Worker for washerrent.com: React Router SSR (workers/app.ts) plus the static
// files in public/ (photos, drawings, icons), served by Workers Assets.
// Secrets and per-environment settings are NOT here: see README.md ("Environment variables")
// and .dev.vars.example. Local values go in .dev.vars (gitignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "washerrent",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The Worker runs first for page URLs (www and trailing-slash redirects, then the pages
  // built ahead of time from ASSETS, workers/app.ts); photos, scripts and icons are served
  // straight from the assets without it.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*", "!/photos/*", "!/brand/*", "!/types/*", "!/favicon.png", "!/apple-touch-icon.png", "!/og-image.jpg"]
  },
  "upload_source_maps": true,
  // `wrangler dev` (pnpm preview) would otherwise present local requests as
  // http://washerrent.com (the first route), and workers/app.ts sends those to https.
  "dev": { "host": "localhost" },
  "workers_dev": true,
  "preview_urls": true,
  // The forms' email (src/shared/api/email.server.ts): free sending to the business's own
  // address, verified in Cloudflare Email Routing. This binding can send to that address only.
  "send_email": [{ "name": "FORM_MAILER", "destination_address": "vladik.didyk@gmail.com" }],
  // washerrent.com and www (www redirects to the apex in workers/app.ts). The workers.dev
  // address stays on as a preview; its pages carry the washerrent.com canonical.
  "routes": [
    { "pattern": "washerrent.com", "custom_domain": true },
    { "pattern": "www.washerrent.com", "custom_domain": true }
  ]
}
